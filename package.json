{
  "name": "dota-workshop-project",
  "version": "0.1.0",
  "description": "Dota 2 Workshop Tools plugin and MCP server.",
  "type": "module",
  "private": true,
  "bin": {
    "dota-workshop-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:plugin": "node ./dist/verify-plugin.js",
    "verify:same-machine-smoke": "node ./dist/verify-same-machine-smoke.js",
    "verify:source-snapshot": "node ./dist/verify-source-snapshot.js",
    "verify:rc": "node ./dist/verify-rc.js",
    "verify:handoff": "node ./dist/verify-handoff.js",
    "verify:milestone": "node ./dist/verify-milestone.js",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
